# Server Configuration
SERVER_NAME=document-reader-chatbot
SERVER_VERSION=1.0.0
ENVIRONMENT=development
PORT=8080
READ_TIMEOUT=30
WRITE_TIMEOUT=30
IDLE_TIMEOUT=60

# Database Configuration
DATABASE_URL=postgres://postgres:password@localhost:5432/document_reader_chatbot?sslmode=disable
DATABASE_NAME=document_reader_chatbot
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10
DB_MAX_LIFETIME=3600

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=document-reader-chatbot

# OpenTelemetry Configuration
OTEL_SERVICE_NAME=document-reader-chatbot
OTEL_SERVICE_VERSION=1.0.0
JAEGER_ENDPOINT=http://localhost:14268/api/traces
METRICS_PORT=9090

# AI Service Configuration (Optional - for future integration)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo

# Security & Performance
BCRYPT_COST=12
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60 